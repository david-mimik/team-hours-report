# team-hours-report settings. Copy to .env (never commit .env) and fill in the empty values.
# mim/scripts/deploy.sh passes them to the mim when it deploys it.

# Jira (Atlassian Cloud): your Atlassian login and an API token from id.atlassian.com -> Security -> API tokens
JIRA_BASE_URL=https://mimiktech.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Tempo: in Jira, Apps -> Tempo -> Settings -> API Integration -> New token
TEMPO_BASE_URL=https://api.tempo.io/4
TEMPO_API_TOKEN=

# What the report counts: the team's Jira project(s), other projects' worklogs by listed people, months of history
TEAM_PROJECTS=ZR
TEAM_EXTRA_WORKLOGS=BES:Hassan Hasan Qadri
TEAM_HISTORY_MONTHS=24

# Chat engine: claude = Claude Code through Muster (Team Advisor's Claude Code engine); local = the node's local LLM
CHAT_ENGINE=claude
CLAUDE_MODEL=sonnet
# Muster's /agent/v1 key (from Muster's registration in the mimOE MCP gateway; see INSTALL.html, step 5)
MUSTER_API_KEY=

# Optional: when set, writes to the mim (page upload, sync, datasets) need "Authorization: Bearer <key>"
WRITE_API_KEY=
